# Copy to .env and fill in. Only VITE_-prefixed values reach the app window; the rest stay in the build/dev server.
# .env is git-ignored; keep real values there, not here.

# Supabase (Project Settings → API Keys). Leave empty to run local-only on IndexedDB.
# The publishable key is safe to ship; row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Claude, browser dev only (`npm run dev`). The desktop app uses the local model instead.
ANTHROPIC_API_KEY=

# Local model server for browser dev; the desktop app uses the Server URL in Settings.
#   Ollama     http://127.0.0.1:11434
#   LM Studio  http://127.0.0.1:1234
#   llama.cpp  http://127.0.0.1:8080
LOCAL_AI_URL=http://127.0.0.1:11434
