# Copy to .env. Only VITE_-prefixed values are bundled into the browser; the rest stay on the server.

# Supabase (Project Settings → API Keys). Leave empty to run local-only on IndexedDB.
# The publishable key is safe in the browser; row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Claude (read by the Vite dev server here, and by the Netlify edge function when hosted).
ANTHROPIC_API_KEY=

# Hosted only: comma-separated emails allowed to use the Claude proxy.
ALLOWED_EMAILS=

# Local model server (OpenAI-compatible), used by `npm run dev`. Default is Ollama.
#   Ollama     http://127.0.0.1:11434
#   LM Studio  http://127.0.0.1:1234
#   llama.cpp  http://127.0.0.1:8080
LOCAL_AI_URL=http://127.0.0.1:11434
